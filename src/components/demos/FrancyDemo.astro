<script>
  function setupFrancy() {
    var root = document.querySelector('[data-francy]');
    if (!root) return;

    var ACCENT = '#8BA99A';

    document.querySelectorAll<HTMLImageElement>('[data-fallback-img]').forEach(function (img) {
      var hide = function () {
        img.style.display = 'none';
      };
      img.addEventListener('error', hide);
      if (img.complete && img.naturalWidth === 0) hide();
    });

    var filterBtns = Array.prototype.slice.call(
      root!.querySelectorAll<HTMLButtonElement>('[data-filter]')
    ) as HTMLButtonElement[];
    var items = Array.prototype.slice.call(
      root!.querySelectorAll<HTMLElement>('[data-gallery-item]')
    ) as HTMLElement[];
    var emptyMsg = root!.querySelector<HTMLElement>('[data-gallery-empty]');

    function paintFilters() {
      filterBtns.forEach(function (b) {
        var on = b.getAttribute('aria-pressed') === 'true';
        b.style.background = on ? ACCENT : '';
        b.style.borderColor = on ? ACCENT : '';
        b.style.color = on ? '#141414' : '';
      });
    }

    function applyFilter(id: string) {
      var visible = 0;
      items.forEach(function (it) {
        var match = id === 'todas' || it.getAttribute('data-cat') === id;
        it.hidden = !match;
        if (match) visible++;
      });
      if (emptyMsg) emptyMsg.hidden = visible > 0;
    }

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) {
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });
        paintFilters();
        applyFilter(btn.getAttribute('data-filter') || 'todas');
      });
    });

    paintFilters();
    applyFilter('todas');

    var lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
    var lightboxImg = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
    var lightboxClose = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    var lastFocused: HTMLElement | null = null;

    function openLightbox(src: string, alt: string, trigger: HTMLElement) {
      if (!lightbox || !lightboxImg) return;
      lastFocused = trigger;
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightbox.hidden = false;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
      if (lightboxClose) lightboxClose.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.hidden = true;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
      if (lastFocused) lastFocused.focus();
    }

    items.forEach(function (it) {
      it.addEventListener('click', function () {
        openLightbox(it.getAttribute('data-src') || '', it.getAttribute('data-alt') || '', it);
      });
    });

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightbox) {
      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) closeLightbox();
      });
    }
    document.addEventListener('keydown', function (e) {
      if ((e as KeyboardEvent).key === 'Escape' && lightbox && !lightbox.hidden) closeLightbox();
    });

    var ba = root!.querySelector<HTMLElement>('[data-ba]');
    var baRange = root!.querySelector<HTMLInputElement>('[data-ba-range]');
    if (ba && baRange) {
      var setPos = function () {
        ba!.style.setProperty('--pos', baRange!.value + '%');
      };
      baRange.addEventListener('input', setPos);
      baRange.addEventListener('change', setPos);
      setPos();
    }

    setupAgenda();
    setupFrancyNav();
  }

  function setupFrancyNav() {
    var ids = ['servicios', 'galeria', 'antes-despues', 'productos', 'sobre', 'agenda', 'ubicacion', 'testimonios', 'faq'];
    var links = Array.prototype.slice.call(document.querySelectorAll('[data-subnav-link]')) as HTMLElement[];
    var headerLinks = Array.prototype.slice.call(document.querySelectorAll('.demo-header-nav a[href^="#"]')) as HTMLElement[];
    var sections = ids.map(function (id) { return document.getElementById(id); }).filter(Boolean) as HTMLElement[];
    var backTop = document.querySelector<HTMLElement>('[data-back-to-top]');
    var subnav = document.querySelector<HTMLElement>('[data-francy-subnav]');

    function setActive(id: string) {
      links.forEach(function (a) {
        if (a.getAttribute('data-subnav-link') === id) a.classList.add('is-active');
        else a.classList.remove('is-active');
      });
      headerLinks.forEach(function (a) {
        var href = (a.getAttribute('href') || '').replace('#', '');
        if (href === id) a.style.color = '#8BA99A';
        else a.style.color = '';
      });
    }

    var obs = new IntersectionObserver(function (entries) {
      var visible = entries.filter(function (e) { return e.isIntersecting; }).sort(function (a, b) { return b.intersectionRatio - a.intersectionRatio; })[0];
      if (visible && visible.target.id) setActive(visible.target.id);
    }, { rootMargin: '-45% 0px -45% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] });
    sections.forEach(function (s) { obs.observe(s); });

    function onScroll() {
      if (!backTop) return;
      if (window.scrollY > 600) backTop.classList.add('is-visible');
      else backTop.classList.remove('is-visible');
      if (subnav) {
        if (window.scrollY > 300) subnav.style.boxShadow = '0 4px 20px rgba(20,20,20,0.06)';
        else subnav.style.boxShadow = '';
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    if (backTop) backTop.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });

    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        var href = a.getAttribute('href') || '';
        if (href.length < 2 || href.indexOf('#') !== 0) return;
        var id = href.slice(1);
        if (ids.indexOf(id) < 0) return;
        var target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', href);
        setActive(id);
      });
    });
  }

  function setupAgenda() {
    var form = document.querySelector<HTMLFormElement>('[data-agenda-form]');
    if (!form) return;

    var STORAGE_KEY = 'francy:ultima-cita';
    var phone = form.getAttribute('data-phone') || '';
    var cierre = form.getAttribute('data-cierre') || '18:00';

    var selectEl = form.querySelector<HTMLSelectElement>('[data-agenda-servicio]');
    var fechaEl = form.querySelector<HTMLInputElement>('[data-agenda-fecha]');
    var nombreEl = form.querySelector<HTMLInputElement>('[data-agenda-nombre]');
    var horaEl = form.querySelector<HTMLInputElement>('[data-agenda-hora]');
    var hintEl = form.querySelector<HTMLElement>('[data-agenda-hint]');
    var domingoEl = form.querySelector<HTMLElement>('[data-agenda-domingo]');
    var errorEl = form.querySelector<HTMLElement>('[data-agenda-error]');
    var resumenEl = form.querySelector<HTMLElement>('[data-agenda-resumen]');
    var resumenTxt = form.querySelector<HTMLElement>('[data-agenda-resumen-texto]');
    var submitBtn = form.querySelector<HTMLButtonElement>('[data-agenda-submit]');
    var slotBtns = Array.prototype.slice.call(
      form.querySelectorAll<HTMLButtonElement>('[data-slot]')
    ) as HTMLButtonElement[];

    if (!selectEl || !fechaEl || !nombreEl || !horaEl) return;

    var ocupadas: Record<string, string[]> = {};
    var dataTag = document.querySelector('[data-agenda-ocupadas]');
    if (dataTag && dataTag.textContent) {
      try {
        ocupadas = JSON.parse(dataTag.textContent) || {};
      } catch (e) {
        ocupadas = {};
      }
    }

    function toMin(hhmm: string) {
      var parts = (hhmm || '').split(':');
      return parseInt(parts[0], 10) * 60 + parseInt(parts[1] || '0', 10);
    }

    function hoyISO() {
      var d = new Date();
      var m = String(d.getMonth() + 1).padStart(2, '0');
      var day = String(d.getDate()).padStart(2, '0');
      return d.getFullYear() + '-' + m + '-' + day;
    }

    fechaEl!.min = hoyISO();

    function servicioActual() {
      var opt = selectEl!.selectedOptions[0];
      if (!opt || !opt.value) return null;
      return {
        name: opt.value,
        price: opt.getAttribute('data-price') || '',
        dur: parseInt(opt.getAttribute('data-dur') || '60', 10),
      };
    }

    function pintarResumen() {
      var svc = servicioActual();
      if (!resumenEl || !resumenTxt) return;
      if (!svc || !fechaEl!.value || !horaEl!.value) {
        resumenEl.hidden = true;
        return;
      }
      resumenEl.hidden = false;
      resumenTxt.textContent = svc.name + ' · ' + fechaEl!.value + ' · ' + horaEl!.value + ' · ' + svc.price;
    }

    function guardar() {
      try {
        window.localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            servicio: selectEl!.value,
            fecha: fechaEl!.value,
            hora: horaEl!.value,
            nombre: nombreEl!.value,
          })
        );
      } catch (e) {
        return;
      }
    }

    function renderSlots() {
      var svc = servicioActual();
      var fecha = fechaEl!.value;
      var ocupadasDia = (fecha && ocupadas[fecha]) || [];
      var cierreMin = toMin(cierre);
      var esHoy = fecha === hoyISO();
      var ahora = new Date();
      var ahoraMin = ahora.getHours() * 60 + ahora.getMinutes();

      slotBtns.forEach(function (btn) {
        var v = btn.getAttribute('data-slot') || '';
        var inicio = toMin(v);
        var stateEl = btn.querySelector<HTMLElement>('.agenda-slot-state');
        var motivo = '';

        if (ocupadasDia.indexOf(v) >= 0) {
          motivo = 'Ocupado';
        } else if (fecha && esHoy && inicio <= ahoraMin) {
          motivo = 'Ya pasó';
        } else if (svc && inicio + svc.dur > cierreMin) {
          motivo = 'No alcanza';
        } else if (
          svc &&
          ocupadasDia.some(function (o) {
            var oi = toMin(o);
            return oi > inicio && oi < inicio + svc!.dur;
          })
        ) {
          motivo = 'No alcanza';
        }

        btn.disabled = motivo !== '';
        if (stateEl) stateEl.textContent = motivo || 'Disponible';

        if (btn.disabled && horaEl!.value === v) {
          horaEl!.value = '';
          btn.setAttribute('aria-pressed', 'false');
        }
      });

      if (hintEl) {
        if (!svc || !fecha) {
          hintEl.hidden = false;
          hintEl.textContent = 'Escoge servicio y fecha para ver los cupos reales de ese día.';
        } else {
          var libres = slotBtns.filter(function (b) {
            return !b.disabled;
          }).length;
          hintEl.hidden = false;
          hintEl.textContent = libres
            ? 'Quedan ' + libres + ' cupos para ' + svc.name.toLowerCase() + ' ese día (' + svc.dur + ' min).'
            : 'No hay cupos ese día. Prueba otra fecha o escríbeme por WhatsApp.';
        }
      }

      if (domingoEl) {
        var dom = false;
        if (fecha) {
          var p = fecha.split('-');
          dom = new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2])).getDay() === 0;
        }
        domingoEl.hidden = !dom;
      }

      pintarResumen();
    }

    slotBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.disabled) return;
        var v = btn.getAttribute('data-slot') || '';
        var yaEstaba = horaEl!.value === v;
        slotBtns.forEach(function (b) {
          b.setAttribute('aria-pressed', 'false');
        });
        horaEl!.value = yaEstaba ? '' : v;
        if (!yaEstaba) btn.setAttribute('aria-pressed', 'true');
        if (errorEl) errorEl.hidden = true;
        pintarResumen();
        guardar();
      });
    });

    [selectEl, fechaEl].forEach(function (el) {
      el!.addEventListener('change', function () {
        if (errorEl) errorEl.hidden = true;
        renderSlots();
        guardar();
      });
    });

    nombreEl!.addEventListener('input', function () {
      if (errorEl) errorEl.hidden = true;
      guardar();
    });

    function mostrarToast(detalle: string) {
      var toast = document.querySelector<HTMLElement>('[data-toast]');
      var det = document.querySelector<HTMLElement>('[data-toast-detalle]');
      if (!toast) return;
      if (det) det.textContent = detalle;
      toast.hidden = false;
      requestAnimationFrame(function () {
        toast!.classList.add('is-visible');
      });
      window.setTimeout(function () {
        toast!.classList.remove('is-visible');
        window.setTimeout(function () {
          toast!.hidden = true;
        }, 320);
      }, 4200);
    }

    function fallar(msg: string, focus: HTMLElement | null) {
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent = msg;
      }
      if (focus) focus.focus();
    }

    if (submitBtn) {
      submitBtn.addEventListener('click', function () {
        var svc = servicioActual();
        if (!svc) return fallar('Falta escoger el servicio.', selectEl);
        if (!fechaEl!.value) return fallar('Falta escoger la fecha.', fechaEl);
        if (!horaEl!.value) return fallar('Falta escoger la hora.', slotBtns[0] || null);
        if (!nombreEl!.value.trim()) return fallar('Falta tu nombre.', nombreEl);

        if (errorEl) errorEl.hidden = true;
        guardar();

        var msg = [
          'Hola Francy Molano Nails Studio, quiero agendar:',
          '• Servicio: ' + svc.name + ' (' + svc.price + ')',
          '• Fecha: ' + fechaEl!.value,
          '• Hora: ' + horaEl!.value,
          '• Nombre: ' + nombreEl!.value.trim(),
          '¿Me confirman disponibilidad? Gracias.',
        ].join('\n');

        mostrarToast(svc.name + ' · ' + fechaEl!.value + ' · ' + horaEl!.value);
        window.open('https://wa.me/' + phone + '?text=' + encodeURIComponent(msg), '_blank', 'noopener,noreferrer');
      });
    }

    try {
      var raw = window.localStorage.getItem(STORAGE_KEY);
      if (raw) {
        var prev = JSON.parse(raw);
        if (prev.servicio) selectEl!.value = prev.servicio;
        if (prev.nombre) nombreEl!.value = prev.nombre;
        if (prev.fecha && prev.fecha >= hoyISO()) fechaEl!.value = prev.fecha;
        if (prev.hora && fechaEl!.value) {
          horaEl!.value = prev.hora;
          slotBtns.forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-slot') === prev.hora ? 'true' : 'false');
          });
        }
      }
    } catch (e) {
      horaEl!.value = '';
    }

    renderSlots();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFrancy);
  } else {
    setupFrancy();
  }
</script>

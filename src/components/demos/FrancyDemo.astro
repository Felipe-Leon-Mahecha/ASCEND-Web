---
import DemoStrip from './DemoStrip.astro';
import DemoHeader from './DemoHeader.astro';
import DemoHero from './DemoHero.astro';
import DemoFooter from './DemoFooter.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { whatsappLink } from '../../lib/site';
import { Icon } from 'astro-icon/components';
import { FRANCY } from '../../lib/francy';

const ocupadasGlob = import.meta.glob<{ default: Record<string, string[]> }>(
  '../../data/francy-ocupadas.json',
  { eager: true }
);
const ocupadas: Record<string, string[]> = Object.values(ocupadasGlob)[0]?.default ?? {};

const accent = '#8BA99A';
const accentDeep = 'color-mix(in srgb, #8BA99A 60%, #141414)';
const coral = '#E8A090';
const base = '#F5F0E8';
const surface = '#FFFFFF';
const tier = 'premium';

const photoPath = '/clientes/francy/';

const wa = whatsappLink('Hola Francy, quiero agendar una cita en el estudio. ¿Me cuentas la disponibilidad?', FRANCY.whatsapp);

const heroShots = [
  { img: `${photoPath}hero-1.jpg`, label: 'Semipermanente', icon: 'lucide:sparkles', grad: 'linear-gradient(150deg,#8BA99A 0%,#C9D8CF 60%,#F5F0E8 100%)' },
  { img: `${photoPath}hero-2.jpg`, label: 'Acrílicas', icon: 'lucide:gem', grad: 'linear-gradient(150deg,#E8A090 0%,#F1CFC4 55%,#F5F0E8 100%)' },
  { img: `${photoPath}hero-3.jpg`, label: 'Pestañas', icon: 'lucide:eye', grad: 'linear-gradient(150deg,#141414 0%,#5F6F66 55%,#C9D8CF 100%)' },
];

const services = [
  { id: 'manicure', icon: 'lucide:hand', name: 'Manicure tradicional', price: '$25.000', desc: 'Limpieza profunda, cutícula y esmaltado clásico.', dur: 45, time: '45 min' },
  { id: 'semipermanente', icon: 'lucide:sparkles', name: 'Semipermanente', price: '$45.000', desc: 'Color parejo y brillo que aguanta hasta 3 semanas.', dur: 60, time: '1 h', hot: true },
  { id: 'acrilicas', icon: 'lucide:gem', name: 'Acrílicas y press-on', price: '$70.000', desc: 'Extensión, esculpidas o press-on con el largo que quieras.', dur: 120, time: '2 h' },
  { id: 'pedicure', icon: 'lucide:footprints', name: 'Pedicure spa', price: '$50.000', desc: 'Exfoliación, masaje y esmaltado para pies descansados.', dur: 60, time: '1 h' },
  { id: 'cejas', icon: 'lucide:scan-face', name: 'Diseño de cejas', price: '$25.000', desc: 'Visagismo, depilación y laminado según tu rostro.', dur: 45, time: '45 min' },
  { id: 'pestanas', icon: 'lucide:eye', name: 'Pestañas', price: '$75.000', desc: 'Lifting o extensiones pelo a pelo, efecto natural.', dur: 90, time: '1 h 30 min' },
];

const slots = [
  { v: '09:00', label: '9:00 am' },
  { v: '10:00', label: '10:00 am' },
  { v: '11:30', label: '11:30 am' },
  { v: '14:00', label: '2:00 pm' },
  { v: '15:30', label: '3:30 pm' },
  { v: '16:30', label: '4:30 pm' },
];

const cierre = FRANCY.closing;

const gallery = [
  { img: `${photoPath}galeria-1.jpg`, cat: 'semipermanente', alt: 'Uñas semipermanentes en tono nude', grad: 'linear-gradient(140deg,#F1CFC4,#E8A090)' },
  { img: `${photoPath}galeria-2.jpg`, cat: 'acrilicas', alt: 'Uñas acrílicas almendra con francés', grad: 'linear-gradient(140deg,#C9D8CF,#8BA99A)' },
  { img: `${photoPath}galeria-3.jpg`, cat: 'cejas', alt: 'Cejas laminadas con diseño natural', grad: 'linear-gradient(140deg,#E9E3D8,#B9A894)' },
  { img: `${photoPath}galeria-4.jpg`, cat: 'semipermanente', alt: 'Semipermanente con detalles dorados', grad: 'linear-gradient(140deg,#F5F0E8,#C9D8CF)' },
  { img: `${photoPath}galeria-5.jpg`, cat: 'acrilicas', alt: 'Acrílicas largas con encapsulado', grad: 'linear-gradient(140deg,#8BA99A,#5F6F66)' },
  { img: `${photoPath}galeria-6.jpg`, cat: 'cejas', alt: 'Extensiones de pestañas efecto rímel', grad: 'linear-gradient(140deg,#141414,#5F6F66)' },
  { img: `${photoPath}galeria-7.jpg`, cat: 'semipermanente', alt: 'Manicure ruso con esmalte rosado', grad: 'linear-gradient(140deg,#F1CFC4,#C9D8CF)' },
  { img: `${photoPath}galeria-8.jpg`, cat: 'acrilicas', alt: 'Press-on con arte a mano alzada', grad: 'linear-gradient(140deg,#E8A090,#8BA99A)' },
];

const filters = [
  { id: 'todas', label: 'Todas' },
  { id: 'semipermanente', label: 'Semipermanente' },
  { id: 'acrilicas', label: 'Acrílicas' },
  { id: 'cejas', label: 'Cejas y pestañas' },
];

const products = [
  { img: `${photoPath}producto-base-titanio.jpg`, name: "Base Uñas de Titanio Chic's", price: '$32.000', desc: 'Base fortalecedora que evita que la uña natural se quiebre.', grad: 'linear-gradient(150deg,#C9D8CF,#8BA99A)' },
  { img: `${photoPath}producto-oleo-organic.jpg`, name: 'Óleo de cutícula Organic', price: '$18.000', desc: 'Aceite nutritivo para cutícula seca. Uso diario.', grad: 'linear-gradient(150deg,#F1CFC4,#E8A090)' },
  { img: `${photoPath}producto-smoothie-mara.jpg`, name: 'Smoothie Mara 350 ml', price: '$38.000', desc: 'Crema corporal humectante de absorción rápida.', grad: 'linear-gradient(150deg,#F5F0E8,#B9A894)' },
  { img: `${photoPath}producto-serum-bioaqua.jpg`, name: 'Sérum BIOAQUA para pestañas', price: '$25.000', desc: 'Sérum de crecimiento para pestañas y cejas.', grad: 'linear-gradient(150deg,#5F6F66,#141414)' },
];

const values = [
  { icon: 'lucide:shield-check', title: 'Bioseguridad real', desc: 'Material esterilizado y limas personales para cada clienta.' },
  { icon: 'lucide:heart-handshake', title: 'Trato cercano', desc: 'Te escucho antes de empezar y trabajamos el diseño juntas.' },
  { icon: 'lucide:award', title: 'Producto profesional', desc: 'Marcas certificadas para que el trabajo dure lo que promete.' },
];

const testimonials = [
  { text: 'Me hice semipermanente y llegué a las tres semanas sin un solo levantamiento. Francy tiene una mano increíble.', name: 'Laura M.', tag: 'Semipermanente' },
  { text: 'Las cejas me cambiaron la cara. Me explicó qué forma me servía y quedaron perfectas.', name: 'Yuli C.', tag: 'Diseño de cejas' },
  { text: 'El estudio es súper limpio y tranquilo. Salgo de ahí como si hubiera ido a un spa.', name: 'Daniela R.', tag: 'Pedicure spa' },
];


const faqs = [
  { q: '¿Necesito agendar o puedo llegar directo?', a: 'Trabajo con cita para dedicarle el tiempo completo a cada clienta. Escríbeme por WhatsApp y te paso los cupos libres de la semana.' },
  { q: '¿Cuánto dura el semipermanente?', a: 'Entre 3 y 4 semanas si sigues el cuidado que te explico al final del servicio. El retiro siempre se hace con torno, nunca halando.' },
  { q: '¿Puedo llevar mi propio diseño?', a: 'Claro. Llega con la foto de referencia y la adaptamos al largo y la forma que mejor le quede a tus manos.' },
  { q: '¿Qué formas de pago reciben?', a: 'Efectivo, Nequi, Daviplata y transferencia Bancolombia. El pago va al terminar el servicio.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NailSalon',
  '@id': `${FRANCY.url}#negocio`,
  name: FRANCY.name,
  description: FRANCY.seoDescription,
  url: FRANCY.url,
  telephone: FRANCY.phoneE164,
  priceRange: FRANCY.priceRange,
  currenciesAccepted: FRANCY.currency,
  paymentAccepted: 'Efectivo, Nequi, Daviplata, transferencia bancaria',
  image: `${photoPath}francy.jpg`,
  logo: `${photoPath}logo.png`,
  areaServed: [
    { '@type': 'City', name: 'Paipa' },
    { '@type': 'City', name: 'Duitama' },
    { '@type': 'City', name: 'Sogamoso' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: FRANCY.street,
    addressLocality: FRANCY.city,
    addressRegion: FRANCY.region,
    postalCode: FRANCY.postalCode,
    addressCountry: FRANCY.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: FRANCY.geo.lat,
    longitude: FRANCY.geo.lng,
  },
  openingHoursSpecification: FRANCY.hours
    .filter((h) => h.days.length > 0)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.days,
      opens: h.opens,
      closes: h.closes,
    })),
  sameAs: [
    `https://www.instagram.com/${FRANCY.instagram}`,
    `https://www.tiktok.com/@${FRANCY.tiktok}`,
  ],
  potentialAction: {
    '@type': 'ReserveAction',
    target: `${FRANCY.url}#agenda`,
    name: 'Agendar cita',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de uñas, cejas y pestañas',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      priceCurrency: FRANCY.currency,
      price: s.price.replace(/[^0-9]/g, ''),
      itemOffered: { '@type': 'Service', name: s.name, description: s.desc },
    })),
  },
};
---

<DemoStrip slug="francy" brand="Francy Molano · Nails Studio" tier={tier} />

<DemoHeader
  brand="Francy Molano"
  accent={accent}
  links={[
    { label: 'Servicios', href: '#servicios' },
    { label: 'Galería', href: '#galeria' },
    { label: 'Productos', href: '#productos' },
    { label: 'Agenda', href: '#agenda' },
  ]}
  ctaText="Agendar cita"
  ctaHref="#agenda"
  light
  showLogoPlaceholder={true}
  logoImage="/clientes/francy/logo.png"
/>

<nav
  data-francy-subnav
  aria-label="Secciones"
  class="sticky top-16 z-30 hidden border-b backdrop-blur md:block"
  style={`background:color-mix(in srgb,${base} 92%,white); border-color:rgba(20,20,20,0.06)`}
>
  <div class="shell flex items-center gap-2 py-2.5">
    {
      [
        { id: 'servicios', label: 'Servicios' },
        { id: 'galeria', label: 'Galería' },
        { id: 'antes-despues', label: 'Antes y después' },
        { id: 'productos', label: 'Productos' },
        { id: 'sobre', label: 'Sobre Francy' },
        { id: 'agenda', label: 'Agenda' },
        { id: 'ubicacion', label: 'Ubicación' },
      ].map((s) => (
        <a
          href={`#${s.id}`}
          data-subnav-link={s.id}
          class="rounded-full px-3.5 py-1.5 text-xs font-semibold text-[#141414]/60 transition-colors"
        >
          {s.label}
        </a>
      ))
    }
  </div>
</nav>

<main style={`background:${base}`} data-francy>
  <DemoHero
    badge="Nails studio · Paipa, Boyacá"
    titleA="Uñas profesionales"
    titleB="en Paipa."
    tagline="Manicure, semipermanente, acrílicas, cejas y pestañas con producto profesional y bioseguridad completa. Agenda tu cita por WhatsApp y te confirmo el mismo día."
    accent={accent}
    palette={[base, '#C9D8CF']}
    ctaText="Agendar cita"
    ctaHref="#agenda"
    secondaryText="Ver trabajos"
    secondaryHref="#galeria"
    meta={['Cita confirmada por WhatsApp', 'Material esterilizado', 'Parqueadero cerca']}
  />

  <section class="pb-24">
    <div class="shell grid gap-4 sm:grid-cols-3">
      {heroShots.map((s) => (
        <figure class="relative aspect-[4/5] overflow-hidden rounded-3xl" style={`background:${s.grad}`}>
          <img
            src={s.img}
            alt={`Trabajo de ${s.label} en Francy Molano Nails Studio`}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
            data-fallback-img
          />
          <figcaption class="absolute inset-x-0 bottom-0 flex items-center gap-2 p-5 text-sm font-semibold text-white" style="background:linear-gradient(to top,rgba(20,20,20,0.55),transparent)">
            <Icon name={s.icon} width={16} height={16} class="h-4 w-4" />
            {s.label}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section id="servicios" class="py-24" style={`background:${surface}`}>
    <div class="shell">
      <div class="max-w-2xl">
        <h2 class="display text-3xl text-[#141414] sm:text-5xl">Servicios y precios</h2>
        <p class="mt-5 text-[#141414]/60">
          Precios en pesos colombianos. El valor final puede variar según el largo y el diseño que escojas.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <div
            class="group relative flex flex-col rounded-3xl border p-7 transition-transform duration-300 hover:-translate-y-1"
            style={`background:${base}; border-color:rgba(20,20,20,0.08)`}
          >
            {s.hot && (
              <span
                class="absolute -top-3 right-6 rounded-full px-3 py-1 text-[11px] font-bold text-[#141414]"
                style={`background:${coral}`}
              >
                Más pedido
              </span>
            )}
            <Icon name={s.icon} width={26} height={26} class="h-6.5 w-6.5" style={`color:${accentDeep}`} />
            <h3 class="mt-5 font-display text-xl font-bold text-[#141414]">{s.name}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[#141414]/60">{s.desc}</p>
            <div class="mt-6 flex items-end justify-between gap-3">
              <span class="font-display text-2xl font-bold text-[#141414]">{s.price}</span>
              <span class="text-xs text-[#141414]/45">{s.time}</span>
            </div>
            <a
              href={whatsappLink(`Hola Francy, quiero agendar ${s.name} (${s.price}). ¿Qué horarios tienes libres?`, FRANCY.whatsapp)}
              target="_blank"
              rel="noopener"
              class="mt-5 inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-bold text-[#141414] transition-transform hover:-translate-y-0.5"
              style={`background:${accent}`}
            >
              <WhatsAppIcon width={16} height={16} class="h-4 w-4" />
              Agendar este servicio
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="galeria" class="py-24">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <h2 class="display text-3xl text-[#141414] sm:text-5xl">Trabajos del estudio</h2>
          <p class="mt-5 text-[#141414]/60">Toca una foto para verla en grande.</p>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar galería">
          {filters.map((f, i) => (
            <button
              type="button"
              data-filter={f.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="rounded-full border px-4 py-2 text-sm font-semibold text-[#141414]/70 transition-colors"
              style="border-color:rgba(20,20,20,0.12)"
            >
              {f.label}
            </button>
          ))}
        </div>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4">
        {gallery.map((g) => (
          <button
            type="button"
            data-gallery-item
            data-cat={g.cat}
            data-src={g.img}
            data-alt={g.alt}
            class="group relative aspect-square overflow-hidden rounded-2xl"
            style={`background:${g.grad}`}
          >
            <img
              src={g.img}
              alt={g.alt}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              data-fallback-img
            />
            <span class="absolute inset-0 flex items-end justify-end p-3 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
              <span class="rounded-full bg-white/90 p-2">
                <Icon name="lucide:maximize-2" width={14} height={14} class="h-3.5 w-3.5 text-[#141414]" />
              </span>
            </span>
          </button>
        ))}
      </div>

      <p data-gallery-empty hidden class="mt-8 text-center text-sm text-[#141414]/50">
        Todavía no hay fotos en esta categoría.
      </p>
    </div>
  </section>

  <section id="antes-despues" class="py-24" style={`background:${surface}`}>
    <div class="shell grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="display text-3xl text-[#141414] sm:text-4xl">Cejas y pestañas: el antes y el después</h2>
        <p class="mt-5 leading-relaxed text-[#141414]/65">
          Arrastra el control para ver el cambio. Trabajo el diseño según la forma de tu rostro, no con plantilla.
        </p>
        <a
          href={whatsappLink('Hola Francy, quiero agendar diseño de cejas. ¿Cuándo tienes cupo?', FRANCY.whatsapp)}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3.5 font-bold text-[#141414] transition-transform hover:-translate-y-0.5"
          style={`background:${accent}`}
        >
          <WhatsAppIcon width={18} height={18} class="h-4.5 w-4.5" />
          Agendar cejas
        </a>
      </div>

      <div
        data-ba
        class="ba relative aspect-[4/3] w-full overflow-hidden rounded-3xl"
        style="--pos:50%"
      >
        <div class="absolute inset-0" style="background:linear-gradient(140deg,#5F6F66,#C9D8CF)">
          <img
            src={`${photoPath}cejas-despues.jpg`}
            alt="Cejas después del diseño"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
            data-fallback-img
          />
          <span class="absolute right-4 bottom-4 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-[#141414]">Después</span>
        </div>

        <div class="ba-clip absolute inset-0" style="background:linear-gradient(140deg,#B9A894,#E9E3D8)">
          <img
            src={`${photoPath}cejas-antes.jpg`}
            alt="Cejas antes del diseño"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
            data-fallback-img
          />
          <span class="absolute bottom-4 left-4 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-[#141414]">Antes</span>
        </div>

        <div class="ba-line pointer-events-none absolute inset-y-0" style={`background:${surface}`}>
          <span class="absolute top-1/2 left-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full shadow-[0_6px_18px_rgba(20,20,20,0.25)]" style={`background:${surface}`}>
            <Icon name="lucide:move-horizontal" width={18} height={18} class="h-4.5 w-4.5 text-[#141414]" />
          </span>
        </div>

        <input
          type="range"
          min="0"
          max="100"
          value="50"
          step="1"
          data-ba-range
          aria-label="Comparar antes y después"
          class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
        />
      </div>
    </div>
  </section>

  <section id="productos" class="py-24">
    <div class="shell">
      <div class="max-w-2xl">
        <h2 class="display text-3xl text-[#141414] sm:text-5xl">Productos que uso y vendo</h2>
        <p class="mt-5 text-[#141414]/60">
          Los mismos que aplico en el estudio. Te los entrego en Paipa o los envío por servientrega.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {products.map((p) => (
          <div class="flex flex-col overflow-hidden rounded-3xl border" style={`background:${surface}; border-color:rgba(20,20,20,0.08)`}>
            <figure class="relative aspect-square" style={`background:${p.grad}`}>
              <img
                src={p.img}
                alt={p.name}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
                data-fallback-img
              />
            </figure>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-display text-base font-bold text-[#141414]">{p.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-[#141414]/60">{p.desc}</p>
              <span class="mt-4 font-display text-xl font-bold text-[#141414]">{p.price}</span>
              <a
                href={whatsappLink(`Hola Francy, quiero pedir "${p.name}" (${p.price}). ¿Tienes disponible?`, FRANCY.whatsapp)}
                target="_blank"
                rel="noopener"
                class="mt-4 inline-flex items-center justify-center gap-2 rounded-full px-4 py-3 text-sm font-bold text-[#141414] transition-transform hover:-translate-y-0.5"
                style={`background:${accent}`}
              >
                <WhatsAppIcon width={16} height={16} class="h-4 w-4" />
                Pedir por WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="sobre" class="py-24" style={`background:${surface}`}>
    <div class="shell grid items-center gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1fr)]">
      <figure class="relative aspect-[4/5] overflow-hidden rounded-3xl" style="background:linear-gradient(160deg,#8BA99A,#E9E3D8)">
        <img
          src={`${photoPath}francy.jpg`}
          alt="Francy Molano en su estudio de uñas en Paipa"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
          data-fallback-img
        />
      </figure>

      <div>
        <h2 class="display text-3xl text-[#141414] sm:text-4xl">Hola, soy Francy</h2>
        <p class="mt-6 leading-relaxed text-[#141414]/70">
          Llevo más de seis años haciendo uñas en Paipa. Empecé atendiendo en la sala de mi casa y hoy tengo un estudio
          propio donde cada cita es personal: una clienta a la vez, sin afanes y con el material esterilizado delante de ti.
        </p>
        <p class="mt-4 leading-relaxed text-[#141414]/70">
          Me capacito cada año en técnicas nuevas de semipermanente, acrílico y visagismo de cejas, porque lo que se ve
          bonito el primer día tiene que seguir bien a las tres semanas.
        </p>

        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          {values.map((v) => (

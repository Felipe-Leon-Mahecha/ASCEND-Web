---
import { getCollection } from 'astro:content';
import DemoLayout from '../../layouts/DemoLayout.astro';
import BarberiaDemo from '../../components/demos/BarberiaDemo.astro';
import BoutiqueDemo from '../../components/demos/BoutiqueDemo.astro';
import MercadosDemo from '../../components/demos/MercadosDemo.astro';
import VeterinariaDemo from '../../components/demos/VeterinariaDemo.astro';
import UnasDemo from '../../components/demos/UnasDemo.astro';
import RestauranteDemo from '../../components/demos/RestauranteDemo.astro';
import FrancyDemo from '../../components/demos/FrancyDemo.astro';

export async function getStaticPaths() {
  const demos = await getCollection('demos');
  return demos.map((demo) => ({
    params: { slug: demo.data.slug },
    props: { demo },
  }));
}

const { demo } = Astro.props;
const demoComponents = {
  barberia: BarberiaDemo,
  boutique: BoutiqueDemo,
  mercados: MercadosDemo,
  veterinaria: VeterinariaDemo,
  unas: UnasDemo,
  restaurante: RestauranteDemo,
  francy: FrancyDemo,
} as const;

const Demo = demoComponents[demo.data.slug as keyof typeof demoComponents];
const subtitle = demo.data.seoDescription ?? demo.data.tagline;
const pageTitle = demo.data.seoTitle ?? `${demo.data.title} — ${demo.data.industry} | Web demo`;
---

<DemoLayout title={pageTitle} description={subtitle} image={demo.data.ogImage}>
  {Demo && <Demo />}
</DemoLayout>
